<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <!-- Pinned, not "latest-recommended". The analyzer rule set ships with the SDK, so
         "latest-*" means the build's pass/fail behaviour silently changes when a developer or
         CI runner updates the SDK: a routine SDK bump produced 48 new diagnostics here, and
         because GloamStrictBuild treats warnings as errors that is a red build for a change
         nobody made. Pinning keeps diagnostics a property of the repository; bump this value
         deliberately, in the same commit that fixes whatever the new rules report. -->
    <AnalysisLevel>10.0-recommended</AnalysisLevel>
    <AnalysisMode>Default</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <EnableWindowsTargeting Condition="'$(OS)' != 'Windows_NT'">true</EnableWindowsTargeting>
    <KnownAnalyzerBacklog>CA1305;CA1310;CA1401;CA1510;CA1513;CA1707;CA1711;CA1712;CA1716;CA1805;CA1822;CA1826;CA1838;CA1859;CA1861</KnownAnalyzerBacklog>
    <NoWarn Condition="'$(GloamAnalyzerAudit)' != 'true'">$(NoWarn);$(KnownAnalyzerBacklog)</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GloamStrictBuild)' == 'true'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
