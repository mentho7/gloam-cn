<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- Brand, project name, assembly, and namespace are all Gloam. AssemblyName and
         RootNamespace are stated explicitly anyway: Gloam.exe and the /Gloam;component/
         pack URIs are runtime identity, so they must not drift if the project file is
         ever renamed again. -->
    <AssemblyName>Gloam</AssemblyName>
    <RootNamespace>Gloam</RootNamespace>
    <Product>Gloam</Product>
    <AssemblyTitle>Gloam</AssemblyTitle>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RollForward>LatestMajor</RollForward>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <PublishTrimmed>false</PublishTrimmed>
    <!-- Default version for local builds; CI overrides via /p:Version=<tag>. Velopack
         compares the installed package version (vpk pack -v) to the release feed, so
         keep this in sync with the tag the release is cut from. -->
    <Version>1.10.0</Version>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <!-- Velopack requires its hooks to run before WPF spins up, so the entry point is a
         custom Main in Program.cs rather than the App.xaml-generated one. -->
    <StartupObject>Gloam.Shell.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

  <!-- Bundled brand fonts (OFL). Referenced via pack URI by typographic family name;
       all weights aggregate under "Plus Jakarta Sans" / "Space Grotesk". -->
  <ItemGroup>
    <Resource Include="Fonts\*.ttf" />
  </ItemGroup>

  <!-- Embedded ICM profiles - extracted at runtime if missing or updated -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\srgb_to_gamma2p2_100_mhc2.icm" Link="Resources\srgb_to_gamma2p2_100_mhc2.icm" />
    <EmbeddedResource Include="..\..\srgb_to_gamma2p2_200_mhc2.icm" Link="Resources\srgb_to_gamma2p2_200_mhc2.icm" />
    <EmbeddedResource Include="..\..\srgb_to_gamma2p2_300_mhc2.icm" Link="Resources\srgb_to_gamma2p2_300_mhc2.icm" />
    <EmbeddedResource Include="..\..\srgb_to_gamma2p2_400_mhc2.icm" Link="Resources\srgb_to_gamma2p2_400_mhc2.icm" />
    <EmbeddedResource Include="..\..\srgb_to_gamma2p2_sdr.icm" Link="Resources\srgb_to_gamma2p2_sdr.icm" />
    <EmbeddedResource Include="..\..\srgb_to_gamma2p2_unspecified.icm" Link="Resources\srgb_to_gamma2p2_unspecified.icm" />
  </ItemGroup>

  <!-- Also ship the templates in the build/publish output. Runtime extraction cannot
       write to Program Files (unelevated), and a mirroring deploy (robocopy /MIR)
       deletes anything not in the publish folder - which silently removed previously
       extracted templates and broke calibration apply ("No MHC2 template found"). -->
  <ItemGroup>
    <None Include="..\..\srgb_to_gamma2p2_100_mhc2.icm" Link="srgb_to_gamma2p2_100_mhc2.icm" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\srgb_to_gamma2p2_200_mhc2.icm" Link="srgb_to_gamma2p2_200_mhc2.icm" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\srgb_to_gamma2p2_300_mhc2.icm" Link="srgb_to_gamma2p2_300_mhc2.icm" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\srgb_to_gamma2p2_400_mhc2.icm" Link="srgb_to_gamma2p2_400_mhc2.icm" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\srgb_to_gamma2p2_sdr.icm" Link="srgb_to_gamma2p2_sdr.icm" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\srgb_to_gamma2p2_unspecified.icm" Link="srgb_to_gamma2p2_unspecified.icm" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Module visibility policy. The UI assembly is a single module composed of vertical
       features, so every feature namespace is importable without a per-file using. The
       point is that reorganising a feature (moving a file between its own folders) never
       turns into a using-directive edit spanning dozens of unrelated files. Namespaces
       still name the owner of a type, which is what review and navigation need. -->
  <ItemGroup>
    <Using Include="Gloam.Shell" />
    <Using Include="Gloam.Controls" />
    <Using Include="Gloam.Features.Calibration" />
    <Using Include="Gloam.Features.Dashboard" />
    <Using Include="Gloam.Features.GameLab" />
    <Using Include="Gloam.Features.NightMode" />
    <Using Include="Gloam.Features.Settings" />
    <Using Include="Gloam.Features.Tray" />
    <Using Include="Gloam.Infrastructure.Dialogs" />
    <Using Include="Gloam.Infrastructure.Platform" />
    <Using Include="Gloam.Infrastructure.Theming" />
    <Using Include="Gloam.Localization" />
    <Using Include="Gloam.Localization.Wpf" />
  </ItemGroup>

  <!-- Translation catalogs ship inside the binary as the baseline set. The same files can also
       be dropped into %LOCALAPPDATA%\Gloam\i18n at runtime, where they override these — see
       LocalizationOptions.ExternalCatalogDirectory. Embedded so a fresh install is translated
       without any post-install step. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\i18n\*.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gloam.Core\Gloam.Core.csproj" />
    <ProjectReference Include="..\Gloam.Interop\Gloam.Interop.csproj" />
    <ProjectReference Include="..\Gloam.Localization\Gloam.Localization.csproj" />
    <ProjectReference Include="..\Gloam.Localization.Wpf\Gloam.Localization.Wpf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Velopack" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Gloam.Tests" />
  </ItemGroup>

</Project>
