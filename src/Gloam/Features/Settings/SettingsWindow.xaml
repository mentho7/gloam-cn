<Window x:Class="Gloam.Features.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Gloam.Controls"
        xmlns:behaviors="clr-namespace:Gloam.Behaviors"
        xmlns:loc="clr-namespace:Gloam.Localization.Wpf;assembly=Gloam.Localization.Wpf"
        Title="Gloam - Settings"
        Width="600" Height="780"
        MinWidth="540" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        Foreground="{DynamicResource ThemeText}"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Gloam;component/Themes/Brutalist.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Square slider: compact track, accent thumb, optional center tick -->
            <Style x:Key="ModernSlider" TargetType="Slider">
                <Setter Property="Height" Value="24"/>
                <Setter Property="Margin" Value="0,4"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Grid>
                                <Border Height="4" VerticalAlignment="Center" Background="{DynamicResource ThemeTrack}"/>
                                <Track x:Name="PART_Track">
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Rectangle Width="14" Height="14" Fill="{DynamicResource ThemeAccent}"/>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CenteredSlider" TargetType="Slider">
                <Setter Property="Height" Value="24"/>
                <Setter Property="Margin" Value="0,4"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Grid>
                                <Border Height="4" VerticalAlignment="Center" Background="{DynamicResource ThemeTrack}"/>
                                <Rectangle Width="2" Height="12" Fill="{DynamicResource ThemeTextDim}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Default: 0"/>
                                <Track x:Name="PART_Track">
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Rectangle Width="14" Height="14" Fill="{DynamicResource ThemeAccent}"/>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="RgbSlider" TargetType="Slider">
                <Setter Property="Height" Value="24"/>
                <Setter Property="Margin" Value="0,4"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Grid>
                                <Border Height="4" VerticalAlignment="Center" Background="{DynamicResource ThemeTrack}"/>
                                <Rectangle Width="2" Height="12" Fill="{DynamicResource ThemeTextDim}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Default: 1.0"/>
                                <Track x:Name="PART_Track">
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Rectangle Width="14" Height="14" Fill="{DynamicResource ThemeAccent}"/>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Mono value readout -->
            <Style x:Key="ValueDisplay" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
            </Style>

            <Style x:Key="EditableValue" TargetType="TextBlock" BasedOn="{StaticResource ValueDisplay}">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="ToolTip" Value="Click to enter value"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="8,0,0,0"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource ThemeAccent}"/>
                        <Setter Property="TextDecorations" Value="Underline"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Section card -->
            <Style x:Key="SectionCard" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource ThemeSurface}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="16"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
            </Style>

            <Style x:Key="SectionHeader" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
            </Style>

            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{DynamicResource ThemeTextDim}"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Margin" Value="0,8,0,4"/>
            </Style>

            <!-- Buttons reuse the shared brutalist templates -->
            <Style x:Key="ModernButton" TargetType="Button" BasedOn="{StaticResource BrutBtnPrimary}"/>
            <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource BrutBtnSecondary}"/>

            <Style x:Key="ModernToggle" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                <Setter Property="Margin" Value="0,4"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{DynamicResource ThemeBg}" BorderBrush="{DynamicResource ThemeWindowFrame}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Border Grid.Row="0" Background="{DynamicResource ThemeSurface}"
                    BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid Margin="16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <controls:BrandMark Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center" GapBrush="{DynamicResource ThemeSurface}"/>
                        <TextBlock Text="GLOAM" FontFamily="{DynamicResource DisplayFont}" FontWeight="ExtraBold"
                                   FontSize="14" Foreground="{DynamicResource ThemeText}" VerticalAlignment="Center"/>
                        <Border Width="1" Height="14" Background="{DynamicResource ThemeTextDim}" Opacity="0.5" Margin="10,0"/>
                        <TextBlock Text="{loc:Tr settings.window.title}" FontFamily="{DynamicResource DisplayFont}" FontWeight="Bold"
                                   FontSize="11" Foreground="{DynamicResource ThemeTextDim}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="&#x2715;" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Width="30" Height="30" FontSize="13"
                            Style="{StaticResource BrutIconButton}" Click="Close_Click" ToolTip="Close"/>
                </Grid>
            </Border>

            <!-- Main Content -->
            <Grid Grid.Row="1" Margin="20,14,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Monitor Selector Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="{loc:Tr settings.monitor.label}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Monitors}" DisplayMemberPath="Label"
                              SelectedItem="{Binding SelectedMonitor}"/>
                </StackPanel>

                <!-- Scrollable Content -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" Padding="0,0,4,0">
                    <StackPanel>

                        <!-- Interface language. App-wide rather than per monitor: it is the one
                             setting on this page that is not a property of a display.
                             {loc:Tr} resolves through the runtime-bound localizer, so the label
                             itself re-renders when the language changes. -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="{loc:Tr settings.language.heading}" Style="{StaticResource SectionHeader}"/>
                                <TextBlock Text="{loc:Tr settings.language.description}"
                                           Foreground="{DynamicResource ThemeTextDim}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <ComboBox ItemsSource="{Binding Languages}"
                                          SelectedItem="{Binding SelectedLanguage}"
                                          DisplayMemberPath="DisplayName"/>
                            </StackPanel>
                        </Border>

                        <!-- Gamma Section -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="{loc:Tr settings.gamma.title}" Style="{StaticResource SectionHeader}"/>
                                <ComboBox SelectedIndex="{Binding GammaModeIndex}">
                                    <ComboBoxItem Content="{loc:Tr settings.gamma.v22}"/>
                                    <ComboBoxItem Content="{loc:Tr settings.gamma.v24}"/>
                                    <ComboBoxItem Content="{loc:Tr settings.gamma.windowsDefault}"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <!-- Brightness/Dimming Section -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{loc:Tr settings.brightness.title}" Style="{StaticResource SectionHeader}"/>
                                    <TextBlock Text="{Binding Value, ElementName=BrightnessSlider, StringFormat={}{0:F0}%}" Style="{StaticResource ValueDisplay}"/>
                                </Grid>
                                <Slider x:Name="BrightnessSlider" IsSnapToTickEnabled="True" TickFrequency="1" Style="{StaticResource ModernSlider}"
                                        Minimum="10" Maximum="100"
                                        Value="{Binding Brightness}"/>
                                <CheckBox Content="{loc:Tr settings.brightness.enhance}"
                                          ToolTip="{loc:Tr settings.brightness.enhanceHint}"
                                          Style="{StaticResource ModernToggle}" Margin="0,8,0,0"
                                          IsChecked="{Binding EnhanceShadows}"/>

                                <!-- Quick Presets -->
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="100%" Style="{StaticResource ModernButton}"
                                            Command="{Binding SetBrightnessCommand}" CommandParameter="100" Margin="0,0,8,0"/>
                                    <Button Content="75%" Style="{StaticResource ModernButton}"
                                            Command="{Binding SetBrightnessCommand}" CommandParameter="75" Margin="0,0,8,0"/>
                                    <Button Content="50%" Style="{StaticResource ModernButton}"
                                            Command="{Binding SetBrightnessCommand}" CommandParameter="50"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Temperature/Tint Section -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="{loc:Tr settings.colorTemp.title}" Style="{StaticResource SectionHeader}"/>

                                <TextBlock Text="{loc:Tr settings.temperature.label}" Style="{StaticResource FieldLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="TemperatureSlider" IsSnapToTickEnabled="True" TickFrequency="1" Grid.Column="0" Style="{StaticResource CenteredSlider}"
                                            Minimum="-50" Maximum="50"
                                            Value="{Binding Temperature}"
                                            behaviors:SliderDetent.IsEnabled="True"
                                            behaviors:SliderDetent.DetentValue="0"
                                            behaviors:SliderDetent.SnapThreshold="2"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Value, ElementName=TemperatureSlider, StringFormat={}{0:F0}}"
                                               Style="{StaticResource EditableValue}" Width="40"
                                               behaviors:ClickToEdit.TargetSlider="{Binding ElementName=TemperatureSlider}"/>
                                </Grid>
                                <Grid>
                                    <TextBlock Text="{loc:Tr settings.temperature.warm}" Foreground="{DynamicResource ThemeTextDim}" FontSize="10"/>
                                    <TextBlock Text="{loc:Tr settings.temperature.cool}" Foreground="{DynamicResource ThemeTextDim}" FontSize="10"
                                               HorizontalAlignment="Right"/>
                                </Grid>

                                <!-- Tint Section -->
                                <TextBlock Text="{loc:Tr settings.tint.label}" Style="{StaticResource FieldLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="TintSlider" IsSnapToTickEnabled="True" TickFrequency="1" Grid.Column="0" Style="{StaticResource CenteredSlider}"
                                            Minimum="-50" Maximum="50"
                                            Value="{Binding Tint}"
                                            behaviors:SliderDetent.IsEnabled="True"
                                            behaviors:SliderDetent.DetentValue="0"
                                            behaviors:SliderDetent.SnapThreshold="2"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Value, ElementName=TintSlider, StringFormat={}{0:F0}}"
                                               Style="{StaticResource EditableValue}" Width="40"
                                               behaviors:ClickToEdit.TargetSlider="{Binding ElementName=TintSlider}"/>
                                </Grid>
                                <Grid>
                                    <TextBlock Text="{loc:Tr settings.tint.green}" Foreground="{DynamicResource ThemeTextDim}" FontSize="10"/>
                                    <TextBlock Text="{loc:Tr settings.tint.magenta}" Foreground="{DynamicResource ThemeTextDim}" FontSize="10"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Per-monitor night-mode controls -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="{loc:Tr settings.nightOverride.title}" Style="{StaticResource SectionHeader}"/>
                                <TextBlock Text="{loc:Tr settings.nightOverride.hint}"
                                           Foreground="{DynamicResource ThemeTextDim}" FontSize="11" Margin="0,0,0,12" TextWrapping="Wrap"/>

                                <TextBlock Text="{loc:Tr settings.offset.label}" Style="{StaticResource FieldLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="TempOffsetSlider" IsSnapToTickEnabled="True" TickFrequency="1" Grid.Column="0" Style="{StaticResource CenteredSlider}"
                                            Minimum="-20" Maximum="20"
                                            Value="{Binding TemperatureOffset}"
                                            behaviors:SliderDetent.IsEnabled="True"
                                            behaviors:SliderDetent.DetentValue="0"
                                            behaviors:SliderDetent.SnapThreshold="1"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Value, ElementName=TempOffsetSlider, StringFormat={}{0:F0}}"
                                               Style="{StaticResource EditableValue}" Width="40"
                                               behaviors:ClickToEdit.TargetSlider="{Binding ElementName=TempOffsetSlider}"/>
                                </Grid>
                                <Grid>
                                    <TextBlock Text="{loc:Tr settings.offset.warmer}" Foreground="{DynamicResource ThemeTextDim}" FontSize="10"/>
                                    <TextBlock Text="{loc:Tr settings.offset.cooler}" Foreground="{DynamicResource ThemeTextDim}" FontSize="10"
                                               HorizontalAlignment="Right"/>
                                </Grid>

                                <Separator Margin="0,16,0,16" Background="{DynamicResource ThemeBorder}"/>
                                <TextBlock Text="{loc:Tr settings.ultraNight.title}" Style="{StaticResource SectionHeader}" FontSize="11" Margin="0,0,0,8" Foreground="{DynamicResource ThemeTextDim}"/>
                                <TextBlock Text="{loc:Tr settings.ultraNight.hint}"
                                           Foreground="{DynamicResource ThemeTextDim}" FontSize="11" Margin="0,-4,0,10" TextWrapping="Wrap"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding NightSpectrumLabel}" Style="{StaticResource MonoValue}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Button Grid.Column="1" Content="{loc:Tr settings.ultraNight.find}" Style="{StaticResource SecondaryButton}"
                                            Padding="12,6" Margin="0,0,8,0" Click="FindNightSpectrum_Click"/>
                                    <Button Grid.Column="2" Content="{loc:Tr settings.ultraNight.clear}"
                                            Padding="12,6" Command="{Binding ClearNightSpectrumCommand}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasNightSpectrum}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- RGB Fine Tuning Section -->
                        <Border Style="{StaticResource SectionCard}">
                            <Expander Header="{loc:Tr settings.rgb.title}" Foreground="{DynamicResource ThemeText}" FontFamily="{DynamicResource DisplayFont}" FontWeight="Bold" IsExpanded="False">
                                <StackPanel Margin="0,12,0,0">
                                    <!-- Red -->
                                    <TextBlock Text="{loc:Tr settings.rgb.red}" Style="{StaticResource FieldLabel}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="RedGainSlider" Grid.Column="0" Style="{StaticResource RgbSlider}"
                                                Minimum="0.5" Maximum="1.5" TickFrequency="0.01"
                                                Value="{Binding RedGain}"
                                                behaviors:SliderDetent.IsEnabled="True"
                                                behaviors:SliderDetent.DetentValue="1.0"
                                                behaviors:SliderDetent.SnapThreshold="0.03"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Value, ElementName=RedGainSlider, StringFormat={}{0:F2}}"
                                                   Style="{StaticResource EditableValue}" Width="40"
                                                   behaviors:ClickToEdit.TargetSlider="{Binding ElementName=RedGainSlider}"/>
                                    </Grid>

                                    <!-- Green -->
                                    <TextBlock Text="{loc:Tr settings.rgb.green}" Style="{StaticResource FieldLabel}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="GreenGainSlider" Grid.Column="0" Style="{StaticResource RgbSlider}"
                                                Minimum="0.5" Maximum="1.5" TickFrequency="0.01"
                                                Value="{Binding GreenGain}"
                                                behaviors:SliderDetent.IsEnabled="True"
                                                behaviors:SliderDetent.DetentValue="1.0"
                                                behaviors:SliderDetent.SnapThreshold="0.03"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Value, ElementName=GreenGainSlider, StringFormat={}{0:F2}}"
                                                   Style="{StaticResource EditableValue}" Width="40"
                                                   behaviors:ClickToEdit.TargetSlider="{Binding ElementName=GreenGainSlider}"/>
                                    </Grid>

                                    <!-- Blue -->
                                    <TextBlock Text="{loc:Tr settings.rgb.blue}" Style="{StaticResource FieldLabel}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="BlueGainSlider" Grid.Column="0" Style="{StaticResource RgbSlider}"
                                                Minimum="0.5" Maximum="1.5" TickFrequency="0.01"
                                                Value="{Binding BlueGain}"
                                                behaviors:SliderDetent.IsEnabled="True"
                                                behaviors:SliderDetent.DetentValue="1.0"
                                                behaviors:SliderDetent.SnapThreshold="0.03"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Value, ElementName=BlueGainSlider, StringFormat={}{0:F2}}"
                                                   Style="{StaticResource EditableValue}" Width="40"
                                                   behaviors:ClickToEdit.TargetSlider="{Binding ElementName=BlueGainSlider}"/>
                                    </Grid>

                                    <Button Content="{loc:Tr settings.resetRgb}" Style="{StaticResource ModernButton}"
                                            Command="{Binding ResetRgbCommand}" Margin="0,12,0,0" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Expander>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- Footer. Live Preview sits on its own row ABOVE the action buttons so the two
                     never compete for horizontal space. Earlier single-row layouts (a right-
                     aligned StackPanel, then a 2-column grid) still let the button group overlap
                     and clip the checkbox to "Live P" once the Apply button appeared. -->
                <StackPanel Grid.Row="2" Margin="0,16,0,0">
                    <CheckBox Content="{loc:Tr settings.livePreview}"
                              Foreground="{DynamicResource ThemeText}"
                              HorizontalAlignment="Left" Margin="0,0,0,10"
                              IsChecked="{Binding IsLivePreview}"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Apply" Command="{Binding ApplyCommand}" Margin="0,0,8,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ModernButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLivePreview}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="{loc:Tr settings.compare}" Style="{StaticResource SecondaryButton}"
                                PreviewMouseDown="Compare_MouseDown" PreviewMouseUp="Compare_MouseUp"
                                Margin="0,0,8,0"/>
                        <Button Content="{loc:Tr settings.resetAll}" Style="{StaticResource SecondaryButton}"
                                Command="{Binding ResetAllCommand}" Margin="0,0,8,0"/>
                        <Button Content="{loc:Tr settings.saveAndClose}" Style="{StaticResource ModernButton}"
                                Command="{Binding SaveAndCloseCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
